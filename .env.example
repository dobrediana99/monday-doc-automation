NODE_ENV=development
PORT=8080
APP_BASE_URL=https://your-service.example

MONDAY_API_TOKEN=change-me
MONDAY_API_URL=https://api.monday.com/v2

GCS_BUCKET=your-template-bucket

GMAIL_CLIENT_ID=change-me
GMAIL_CLIENT_SECRET=change-me
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_REFRESH_TOKEN=change-me
GMAIL_SENDER=sender@example.com

# Signing link validity window (48h default)
SIGN_TOKEN_TTL_MINUTES=2880

# Persistent signing sessions (required in production)
# Local example: redis://localhost:6379
SIGNING_REDIS_URL=
SIGNING_REDIS_PREFIX=signing
SIGNING_REDIS_CONNECT_TIMEOUT_MS=5000

# Webhook dedupe (in-memory)
IDEMPOTENCY_TTL_MINUTES=60

# Optional: verify incoming Monday webhooks
WEBHOOK_SECRET=

